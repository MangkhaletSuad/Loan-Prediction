# Copy this file to .env on the Linux server, then replace every placeholder.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
MARIADB_ROOT_PASSWORD=replace-with-a-long-unique-database-password
DB_NAME=db
DB_HOST=127.0.0.1
ADMIN_EMAILS=admin@example.com
DB_PORT=13306
# Linux host folders. Flask reads and writes these paths directly.
FILE_STORAGE_DIR=/srv/flowvault/storage
RECYCLE_BIN_DIR=/srv/flowvault/recycle-bin
SESSION_COOKIE_SECURE=1
TRUSTED_PROXY_COUNT=1
